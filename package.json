{
  "name": "anorbank-categorization-ad",
  "version": "1.0.0",
  "private": true,
  "description": "Premium product ad for Anorbank expense categorization, built with Remotion",
  "scripts": {
    "start": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render AnorbankCategorization out/anorbank-categorization.mp4 --codec=h264 --crf=16",
    "render:preview": "remotion render AnorbankCategorization out/preview.mp4 --codec=h264 --crf=28 --scale=0.5",
    "still": "remotion still AnorbankCategorization out/frame.png",
    "typecheck": "tsc --noEmit",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "4.0.524",
    "@remotion/fonts": "^4.0.524",
    "@remotion/media-utils": "4.0.524",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.524"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.8.3"
  }
}
